local _ENV = (getgenv or function() return _G end)()

local _HexDecoder = function(hex)
    local t = {}
    for i = 1, #hex, 2 do
        t[#t + 1] = string.char(tonumber(hex:sub(i, i + 1), 16))
    end
    return table.concat(t)
end

local _EncryptedPayload = [[
local _S = setmetatable({}, { __index = function(_, n) return game:GetService(n) end })
local Players, ReplicatedStorage, TweenService, RunService, VirtualUser, Workspace = 
	_S.Players, _S.ReplicatedStorage, _S.TweenService, _S.RunService, _S.VirtualUser, _S.Workspace

local LP = Players.LocalPlayer
_ENV.NevaConfig = {
	AutoFarm = true,
	AutoQuest = true,
	FastAttack = true,
	MobAura = true,
	AutoHaki = true,
	BringRadius = 400,
	FarmDistance = 4,
	TweenSpeed = 350,
	BypassNoclip = true
}
local Config = _ENV.NevaConfig

local success, OrionLib = pcall(function()
	return loadstring(game:HttpGet('https://raw.githubusercontent.com/shlexware/Orion/main/source'))()
end)

if not success or not OrionLib then
	OrionLib = loadstring(game:HttpGet('https://raw.githubusercontent.com/johannes-man/Orion/main/source'))()
end

local Window = OrionLib:MakeWindow({
	Name = "Chuppy Hub | V11 Anti-Ghost Core",
	HidePremium = false,
	SaveConfig = true,
	ConfigFolder = "ChuppyNevaStyle"
})

local function GetChar()
	local char = LP.Character
	if char and char:FindFirstChild("HumanoidRootPart") and char:FindFirstChild("Humanoid") then
		return char, char.Humanoid, char.HumanoidRootPart
	end
	return nil, nil, nil
end

local function GetCommF()
	return ReplicatedStorage:FindFirstChild("CommF_") 
		or (ReplicatedStorage:FindFirstChild("Remotes") and ReplicatedStorage.Remotes:FindFirstChild("CommF_")) 
		or nil
end

local function GetLevel()
	local success, level = pcall(function()
		return LP.Data.Level.Value
	end)
	return success and level or 1
end

local function GetPreferredTool()
	local char, _, _ = GetChar()
	if not char then return nil end

	local meleeKeywords = {"combat", "dark step", "electro", "water kung fu", "dragon breath", "superhuman", "death step", "sharkman karate", "electric claw", "godhuman", "sanguine art", "melee"}

	for _, tool in ipairs(char:GetChildren()) do
		if tool:IsA("Tool") then
			local tName = tool.Name:lower()
			local tTip = (tool.ToolTip or ""):lower()
			if tTip == "melee" then return tool end
			for _, kw in ipairs(meleeKeywords) do
				if tName:find(kw) then return tool end
			end
		end
	end

	for _, tool in ipairs(LP.Backpack:GetChildren()) do
		if tool:IsA("Tool") then
			local tName = tool.Name:lower()
			local tTip = (tool.ToolTip or ""):lower()
			if tTip == "melee" then return tool end
			for _, kw in ipairs(meleeKeywords) do
				if tName:find(kw) then return tool end
			end
		end
	end

	return char:FindFirstChildOfClass("Tool") or LP.Backpack:FindFirstChildOfClass("Tool")
end

local CurrentTween = nil
local LastTweenPos = Vector3.new()

local function Tween(TargetCFrame)
	local char, hum, hrp = GetChar()
	if not hrp then return end

	local targetPos = typeof(TargetCFrame) == "CFrame" and TargetCFrame.Position or TargetCFrame
	local distance = (hrp.Position - targetPos).Magnitude
	
	if distance <= 6 then
		if CurrentTween then CurrentTween:Cancel() end
		hrp.CFrame = typeof(TargetCFrame) == "CFrame" and TargetCFrame or CFrame.new(TargetCFrame)
		return
	end

	if (LastTweenPos - targetPos).Magnitude > 5 or not CurrentTween then
		LastTweenPos = targetPos
		if CurrentTween then CurrentTween:Cancel() end
		local speed = distance / Config.TweenSpeed
		local finalCF = typeof(TargetCFrame) == "CFrame" and TargetCFrame or CFrame.new(TargetCFrame)
		CurrentTween = TweenService:Create(hrp, TweenInfo.new(speed, Enum.EasingStyle.Linear), {CFrame = finalCF})
		CurrentTween:Play()
	end
end

local function GetCurrentQuest()
	local lvl = GetLevel()
	if lvl <= 9 then return "BanditQuest1", 1, "Bandit", CFrame.new(1059, 16, 1549)
	elseif lvl <= 14 then return "JungleQuest", 1, "Monkey", CFrame.new(-1598, 36, 153)
	elseif lvl <= 29 then return "JungleQuest", 2, "Gorilla", CFrame.new(-1649, 36, 175)
	elseif lvl <= 39 then return "BuggyQuest1", 1, "Pirate", CFrame.new(-1140, 4, 3827)
	elseif lvl <= 54 then return "BuggyQuest1", 2, "Brute", CFrame.new(-1140, 4, 3827)
	elseif lvl <= 74 then return "DesertQuest", 1, "Desert Bandit", CFrame.new(896, 6, 4390)
	elseif lvl <= 89 then return "DesertQuest", 2, "Desert Officer", CFrame.new(896, 6, 4390)
	elseif lvl <= 99 then return "SnowQuest", 1, "Snow Bandit", CFrame.new(1389, 87, -1298)
	elseif lvl <= 119 then return "SnowQuest", 2, "Snowman", CFrame.new(1389, 87, -1298)
	elseif lvl <= 149 then return "MarineQuest", 1, "Chief Petty Officer", CFrame.new(-5035, 20, 4324)
	elseif lvl <= 174 then return "SkyQuest", 1, "Sky Bandit", CFrame.new(-4842, 717, -2623)
	elseif lvl <= 189 then return "SkyQuest", 2, "Dark Master", CFrame.new(-5268, 389, -2275)
	elseif lvl <= 209 then return "PrisonerQuest", 1, "Prisoner", CFrame.new(5310, 1, 475)
	elseif lvl <= 249 then return "PrisonerQuest", 2, "Dangerous Prisoner", CFrame.new(5310, 1, 475)
	elseif lvl <= 274 then return "ColosseumQuest", 1, "Toga Warrior", CFrame.new(-1580, 7, -2985)
	elseif lvl <= 299 then return "ColosseumQuest", 2, "Gladiator", CFrame.new(-1580, 7, -2985)
	elseif lvl <= 324 then return "MagmaQuest", 1, "Military Soldier", CFrame.new(-5315, 12, 8515)
	elseif lvl <= 374 then return "MagmaQuest", 2, "Military Spy", CFrame.new(-5315, 12, 8515)
	elseif lvl <= 399 then return "FishmanQuest", 1, "Fishman Warrior", CFrame.new(61123, 19, 1569)
	elseif lvl <= 449 then return "FishmanQuest", 2, "Fishman Commando", CFrame.new(61123, 19, 1569)
	elseif lvl <= 524 then return "FountainQuest", 1, "Galley Pirate", CFrame.new(5253, 38, 4050)
	elseif lvl <= 599 then return "FountainQuest", 2, "Galley Captain", CFrame.new(5253, 38, 4050)
	elseif lvl <= 700 then return "FountainQuest", 3, "Ice Admiral", CFrame.new(5253, 38, 4050)
	else return "Area1Quest", 1, "Raider", CFrame.new(-424, 72, 1836)
	end
end

-- Bộ lọc loại bỏ hoàn toàn quái ảo, quái chết giả
local function GetTargetEnemy(enemyName)
	local char, hum, hrp = GetChar()
	if not hrp then return nil end

	local closest, shortestDist = nil, math.huge
	local fallbackClosest, fallbackDist = nil, math.huge
	local searchFolders = {Workspace:FindFirstChild("Enemies"), Workspace:FindFirstChild("SeaEvents")}

	for _, folder in ipairs(searchFolders) do
		if folder then
			for _, enemy in ipairs(folder:GetChildren()) do
				local eHrp = enemy:FindFirstChild("HumanoidRootPart")
				local eHum = enemy:FindFirstChild("Humanoid")
				
				-- Kiểm tra kỹ lưỡng: Phải đang hoạt động, chưa chết, và có máu thực tế lớn hơn 0
				if eHrp and eHum and eHum.Health > 0 and enemy.Parent then
					if eHum.Health > 1 then -- Chống quái ảo / quái đang tan biến
						local dist = (hrp.Position - eHrp.Position).Magnitude
						if dist < fallbackDist then
							fallbackClosest = enemy
							fallbackDist = dist
						end
						if not enemyName or enemy.Name == enemyName or string.find(enemy.Name, enemyName) then
							if dist < shortestDist then
								closest = enemy
								shortestDist = dist
							end
						end
					end
				end
			end
		end
	end
	
	return closest or fallbackClosest
end

LP.Idled:Connect(function()
	VirtualUser:CaptureController()
	VirtualUser:ClickButton2(Vector2.new(0, 0))
end)

RunService.Stepped:Connect(function()
	if Config.BypassNoclip then
		local char = LP.Character
		if char then
			for _, part in ipairs(char:GetDescendants()) do
				if part:IsA("BasePart") then
					part.CanCollide = false
				end
			end
		end
	end
end)

local FarmTab = Window:MakeTab({Name = "Main Farm", Icon = "rbxassetid://4483345998"})
local CombatTab = Window:MakeTab({Name = "Combat Engine", Icon = "rbxassetid://4483345998"})

FarmTab:AddSection({Name = "Auto Farming Level"})
FarmTab:AddToggle({ Name = "Auto Farm Level", Default = Config.AutoFarm, Callback = function(v) Config.AutoFarm = v end })
FarmTab:AddToggle({ Name = "Auto Accept Quest", Default = Config.AutoQuest, Callback = function(v) Config.AutoQuest = v end })
FarmTab:AddToggle({ Name = "Bring Mobs (Mob Aura)", Default = Config.MobAura, Callback = function(v) Config.MobAura = v end })

CombatTab:AddSection({Name = "Attack Options"})
CombatTab:AddToggle({ Name = "Fast Attack Mode", Default = Config.FastAttack, Callback = function(v) Config.FastAttack = v end })
CombatTab:AddToggle({ Name = "Auto Buso Haki", Default = Config.AutoHaki, Callback = function(v) Config.AutoHaki = v end })

task.spawn(function()
	while task.wait(2) do
		if Config.AutoHaki and Config.AutoFarm then
			pcall(function()
				local char = LP.Character
				if char and not char:FindFirstChild("HasBuso") then
					local commF = GetCommF()
					if commF then commF:InvokeServer("Buso") end
				end
			end)
		end
	end
end)

task.spawn(function()
	while task.wait(0.15) do
		if Config.AutoFarm then
			pcall(function()
				local char, hum, hrp = GetChar()
				if not hrp or hum.Health <= 0 then return end

				local qName, qIdx, mobName, qPos = GetCurrentQuest()
				local commF = GetCommF()
				local mainGui = LP.PlayerGui:FindFirstChild("Main")
				local hasQuest = mainGui and mainGui:FindFirstChild("Quest") and mainGui.Quest.Visible

				if Config.AutoQuest and not hasQuest and commF then
					if (hrp.Position - qPos.Position).Magnitude > 10 then
						Tween(qPos)
					else
						commF:InvokeServer("StartQuest", qName, qIdx)
						task.wait(0.5)
					end
				else
					local enemy = GetTargetEnemy(mobName)
					if enemy and enemy:FindFirstChild("HumanoidRootPart") then
						Tween(enemy.HumanoidRootPart.CFrame * CFrame.new(0, Config.FarmDistance, 0))
					end
				end
			end)
		end
	end
end)

task.spawn(function()
	while task.wait(0.02) do
		if Config.AutoFarm and Config.FastAttack then
			pcall(function()
				local char, hum = GetChar()
				if char and hum then
					local tool = GetPreferredTool()
					if tool then
						if tool.Parent ~= char then hum:EquipTool(tool) end
						tool:Activate()
						local remotes = ReplicatedStorage:FindFirstChild("Remotes")
						if remotes and remotes:FindFirstChild("RegisterAttack") then
							remotes.RegisterAttack:FireServer(0)
						end
					end
				end
			end)
		end
	end
end)

task.spawn(function()
	while task.wait(0.1) do
		if Config.MobAura then
			pcall(function()
				local char, hum, hrp = GetChar()
				if not hrp then return end

				local searchFolders = {Workspace:FindFirstChild("Enemies"), Workspace:FindFirstChild("SeaEvents")}
				for _, folder in ipairs(searchFolders) do
					if folder then
						for _, mob in ipairs(folder:GetChildren()) do
							local mHrp = mob:FindFirstChild("HumanoidRootPart")
							local mHum = mob:FindFirstChild("Humanoid")
							-- Chỉ kéo những con quái thực sự còn sống, bỏ qua quái ảo
							if mHrp and mHum and mHum.Health > 1 and mob.Parent then
								if (hrp.Position - mHrp.Position).Magnitude < Config.BringRadius then
									mHrp.CFrame = hrp.CFrame * CFrame.new(0, 0, 2)
									mHrp.CanCollide = false
									mHrp.AssemblyLinearVelocity = Vector3.zero
									mHum.WalkSpeed = 0
								end
							end
						end
					end
				end
			end)
		end
	end
end)

OrionLib:Init()
]]

local success, result = pcall(function()
	return loadstring(_EncryptedPayload)()
end)

if not success then
	warn("[Chuppy Hub Secure Wrapper Error]: " .. tostring(result))
end

