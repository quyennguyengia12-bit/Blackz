--[[
    Script: Rayfield Fly GUI (Clone của Universal Script Better Fly GUI)
    Tính năng: Bay chính xác như script gốc, hỗ trợ noclip, tốc độ xoay, 2 phương thức bay
    Cấu hình mặc định: rotationSpeed = 1, noclipfly = true, useV3Method = false
--]]

-- Kiểm tra và load Rayfield nếu chưa có
if not game:GetService("CoreGui"):FindFirstChild("Rayfield") then
    local RayfieldLibrary = loadstring(game:HttpGet("https://raw.githubusercontent.com/shlexware/Rayfield/main/source"))()
    wait(1)
end

local Rayfield = require(game:GetService("CoreGui"):WaitForChild("Rayfield").Client)

-- Tạo Window chính
local Window = Rayfield:CreateWindow({
    Name = "Better Fly GUI",
    Icon = 0,
    LoadingTitle = "Đang tải Fly GUI...",
    LoadingSubtitle = "by Rayfield",
    Theme = "Default",
    ConfigurationSaving = {
        Enabled = true,
        FolderName = "BetterFlyGUI",
        FileName = "Settings"
    },
    Keybind = {
        Enabled = true,
        Key = "RightAlt",
        HoldToInteract = false
    }
})

-- Tạo các Tab
local MainTab = Window:CreateTab("Điều khiển bay", 4483362458)
local SettingsTab = Window:CreateTab("Cài đặt", 4483362458)
local InfoTab = Window:CreateTab("Thông tin", 4483362458)

-- Biến toàn cục (giống cấu hình gốc)
getgenv().rotationSpeed = 1
getgenv().noclipfly = true
getgenv().useV3Method = false

local flying = false
local noclip = getgenv().noclipfly
local speed = 50
local rotationSpeed = getgenv().rotationSpeed
local useV3Method = getgenv().useV3Method

local player = game.Players.LocalPlayer
local character = player.Character or player.CharacterAdded:Wait()
local humanoid = character:WaitForChild("Humanoid")
local hrp = character:WaitForChild("HumanoidRootPart")

-- Biến cho cơ chế bay
local bodyVelocity = nil
local bodyGyro = nil
local vehicleSeat = nil
local lc = nil

-- Hàm tạo VehicleSeat cho phương thức V3
local function createVehicleSeat()
    local seat = Instance.new("VehicleSeat")
    seat.CanCollide = false
    seat.Transparency = 1
    seat.Anchored = false
    seat.Parent = character
    seat.Position = hrp.Position
    return seat
end

-- Hàm xóa các bộ điều khiển cũ
local function clearFlyControls()
    if bodyVelocity then bodyVelocity:Destroy() end
    if bodyGyro then bodyGyro:Destroy() end
    if vehicleSeat then vehicleSeat:Destroy() end
    if lc then lc:Disconnect() end
    bodyVelocity = nil
    bodyGyro = nil
    vehicleSeat = nil
    lc = nil
end

-- Hàm bật/tắt noclip (giống script gốc)
local function setNoclip(state)
    noclip = state
    getgenv().noclipfly = state
    
    local function applyNoclip(char)
        for _, v in pairs(char:GetDescendants()) do
            if v:IsA("BasePart") then
                v.CanCollide = not noclip
            end
        end
    end
    
    if noclip then
        player.CharacterAdded:Connect(function(char)
            char:WaitForChild("HumanoidRootPart")
            applyNoclip(char)
        end)
        applyNoclip(character)
    else
        applyNoclip(character)
    end
end

-- Phương thức bay V2 (BodyVelocity + BodyGyro) - Giống script gốc
local function startFlyV2()
    clearFlyControls()
    
    bodyVelocity = Instance.new("BodyVelocity")
    bodyGyro = Instance.new("BodyGyro")
    
    bodyVelocity.MaxForce = Vector3.new(1e5, 1e5, 1e5)
    bodyVelocity.P = 1e4
    bodyGyro.MaxTorque = Vector3.new(1e5, 1e5, 1e5)
    bodyGyro.P = 1e4
    bodyGyro.CFrame = hrp.CFrame
    
    bodyVelocity.Parent = hrp
    bodyGyro.Parent = hrp
    
    lc = game:GetService("RunService").RenderStepped:Connect(function()
        if not flying then return end
        
        local moveDirection = Vector3.new()
        local forward = hrp.CFrame.LookVector
        local right = hrp.CFrame.RightVector
        local up = hrp.CFrame.UpVector
        
        if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.W) then
            moveDirection = moveDirection + forward
        end
        if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.S) then
            moveDirection = moveDirection - forward
        end
        if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.D) then
            moveDirection = moveDirection + right
        end
        if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.A) then
            moveDirection = moveDirection - right
        end
        if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.Space) then
            moveDirection = moveDirection + up
        end
        if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.LeftControl) then
            moveDirection = moveDirection - up
        end
        
        if moveDirection.Magnitude > 0 then
            moveDirection = moveDirection.Unit
        end
        
        bodyVelocity.Velocity = moveDirection * speed
        bodyGyro.CFrame = hrp.CFrame * CFrame.Angles(0, 0, 0)
    end)
end

-- Phương thức bay V3 (VehicleSeat) - Giống script gốc
local function startFlyV3()
    clearFlyControls()
    
    vehicleSeat = createVehicleSeat()
    humanoid.Sit = true
    
    lc = game:GetService("RunService").RenderStepped:Connect(function()
        if not flying or not vehicleSeat then return end
        
        local moveDirection = Vector3.new()
        local forward = hrp.CFrame.LookVector
        local right = hrp.CFrame.RightVector
        local up = hrp.CFrame.UpVector
        
        if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.W) then
            moveDirection = moveDirection + forward
        end
        if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.S) then
            moveDirection = moveDirection - forward
        end
        if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.D) then
            moveDirection = moveDirection + right
        end
        if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.A) then
            moveDirection = moveDirection - right
        end
        if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.Space) then
            moveDirection = moveDirection + up
        end
        if game:GetService("UserInputService"):IsKeyDown(Enum.KeyCode.LeftControl) then
            moveDirection = moveDirection - up
        end
        
        if moveDirection.Magnitude > 0 then
            moveDirection = moveDirection.Unit
        end
        
        vehicleSeat.Velocity = moveDirection * speed
        vehicleSeat.Steer = 0
        vehicleSeat.Throttle = 0
    end)
end

-- Hàm bật/tắt bay
local function toggleFly(state)
    flying = state
    
    if flying then
        if useV3Method then
            startFlyV3()
        else
            startFlyV2()
        end
        
        -- Giữ nguyên trạng thái noclip
        setNoclip(noclip)
        
        -- Ẩn thanh trượt (optional)
        humanoid.PlatformStand = true
    else
        clearFlyControls()
        humanoid.PlatformStand = false
        humanoid.Sit = false
        setNoclip(false)
    end
end

